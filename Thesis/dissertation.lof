\contentsline {figure}{\numberline {1.1}{\ignorespaces Fig. 3 from Drazkowska2023. This figure provides a general scale for the stages of CA.}}{3}{figure.caption.12}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces Fig 1c of \citealp {Pollack1996}. The initial rise corresponds to the runaway planetesimal accretion of phase 1; the long plateau corresponds to the transitionary phase 2; the sharp increasing corresponds to both accretion rates rapidly increasing (and the runaway gas accretion) in phase 3}}{5}{figure.caption.13}%
\contentsline {figure}{\numberline {1.3}{\ignorespaces Fig. 2 from Longarini \& Lodato 2026. It shows two potential transport mechanisms that drive the formation of spiral arms, where infall is from increasing surface density ($\Sigma $) or cooling (decreasing sound speed $c_s$)}}{7}{figure.caption.15}%
