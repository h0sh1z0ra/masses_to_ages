\contentsline {figure}{\numberline {1.1}{\ignorespaces Figure 1c of \citealp {Pollack1996}. The initial rise corresponds to the initial planetesimal accretion; the long plateau corresponds to the long steady accretion of gas, planetesimals and pebbles; the sharp increase corresponds to the runaway gas accretion and increased planetesimal accretion.}}{4}{figure.caption.11}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces Fig. 2 from \citealp {Longarini2026} (edited). It shows two potential transport mechanisms that drive the formation of spiral arms, where infall is from increasing surface density ($\Sigma $) or cooling (decreasing sound speed $c_s$)}}{6}{figure.caption.13}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces The findings of \citet {Bowler2020a}. Top: eccentricity distribution of the combined sample. Bottom: eccentricity distributions separated by planets and brown dwarfs.}}{11}{figure.caption.20}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Figure 1 of \citet {Ginski2020}. Top: two clearly resolved bodies from the paper's observations with SPHERE. Bottom: VLT/NACO image from 2003; the companion isn't clearly resolved but an elongation to the Northwest is clearly visible.}}{13}{figure.caption.21}%
